DATABASE_URL="postgresql://postgres:postgres@localhost:5432/whatsapp_ai_saas"
AUTH_SECRET="change-me-to-a-long-random-string"
# Optional: separate key for encrypting stored tokens (defaults to AUTH_SECRET). Changing it makes saved tokens unreadable.
ENCRYPTION_KEY=""
# MUST be a public https URL for WhatsApp/Moyasar to reach you (ngrok in dev, your domain in prod)
APP_URL="http://localhost:3000"

# WhatsApp Cloud API (Meta)
WHATSAPP_VERIFY_TOKEN="my-webhook-verify-token"
WHATSAPP_APP_SECRET="meta-app-secret"
WHATSAPP_API_VERSION="v21.0"

# AI provider. FREE option (no credit card): Google Gemini via AI Studio, get a key at https://aistudio.google.com/apikey
# NOTE: on Google's free tier your prompts may be used to improve their products. Use it for testing, not real customer data.
AI_PROVIDER="openai"                  # "openai" = any OpenAI-compatible API (Gemini/Groq/OpenRouter/Ollama), "anthropic" = Claude (paid)
OPENAI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai"
OPENAI_API_KEY=""                     # your Gemini API key
AI_MODEL="gemini-3.8-flash"
AI_REASONING_EFFORT="low"             # faster + cheaper replies; leave empty for providers that don't support it
# ANTHROPIC_API_KEY=""                # only if AI_PROVIDER="anthropic" (needs paid credit)

# Payments: Moyasar (https://moyasar.com). Platform key = your subscription revenue.
# Each merchant adds THEIR OWN key in dashboard/settings for customer orders.
MOYASAR_SECRET_KEY=""
PAYMENTS_WEBHOOK_SECRET="change-me"   # random string, appended to the callback URL

# Password reset email via Gmail SMTP. Create an App Password after enabling 2-Step Verification:
# https://myaccount.google.com/apppasswords (do not use your normal Gmail password).
# Gmail defaults to smtp.gmail.com:465 when SMTP_HOST/SMTP_PORT are omitted.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM=""

# File uploads: "local" (default) or "s3" (AWS S3 / Cloudflare R2 / Supabase)
STORAGE_DRIVER="local"
UPLOAD_DIR="./uploads"
S3_BUCKET=""
S3_REGION="auto"          # AWS: exact bucket region (e.g. us-east-1); R2/others: provider value
S3_ENDPOINT=""            # Leave blank for AWS S3; set only for R2/Supabase-compatible storage
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""          # AWS: https://<bucket>.s3.<region>.amazonaws.com

# Queue worker: polls inside the Next server. Set to "off" on serverless and call /api/jobs/run from a cron instead.
JOB_WORKER="on"
CRON_SECRET=""
